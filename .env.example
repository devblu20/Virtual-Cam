# Server only. Never commit .env or put these values in frontend/extension code.
DECART_API_KEY=
# Run: python scripts/create_access_key.py first-user
# Paste the JSON of user IDs and SHA-256 digests here (not the raw access keys).
VCAM_ACCESS_KEYS={}
# Local use only. Railway supplies PORT automatically.
PORT=5173

# Private photo library; leave unset to disable storage (video still works).
# Railway: attach a volume at /data, set VCAM_DATA_DIR=/data/bluqq
# and RAILWAY_RUN_UID=0 for this image's volume permissions.
# Local example: VCAM_DATA_DIR=./data
VCAM_DATA_DIR=
